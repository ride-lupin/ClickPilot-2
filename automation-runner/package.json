{
  "name": "clickpilot-automation-runner",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "package:mac": "pkg dist/index.js --targets node18-macos-arm64,node18-macos-x64 --out-path dist-sidecar",
    "package:win": "pkg dist/index.js --targets node18-win-x64 --out-path dist-sidecar"
  },
  "dependencies": {
    "playwright-core": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "pkg": "latest",
    "typescript": "latest",
    "vitest": "latest"
  }
}
