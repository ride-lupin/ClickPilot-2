{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ClickPilot",
  "version": "0.1.0",
  "identifier": "com.clickpilot.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173"
  },
  "app": {
    "windows": [
      {
        "title": "ClickPilot",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "msi"],
    "resources": ["../automation-runner/dist-sidecar/*"]
  }
}
